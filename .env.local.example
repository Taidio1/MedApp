# Supabase project credentials — get from: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend FastAPI URL for the Next.js server route (Docker uses http://api:8000)
# BACKEND_API_URL=http://localhost:8000

# Public backend URL (legacy/local override, optional)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase service role key (server-only, optional — needed for service-role operations)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
